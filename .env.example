# ===========================================
# Locopilot Monitor - Optimization Settings
# ===========================================

# Application Environment
ENVIRONMENT=production
PROD_LOG_LEVEL=INFO
DEV_LOG_LEVEL=DEBUG

# ===========================================
# TIER 1: Quick Wins (Pose Caching & Logging)
# ===========================================
# These are implemented in code and always active

# ===========================================
# TIER 2: ONNX Runtime (3x faster CPU inference)
# ===========================================
# Enables ONNX Runtime for significantly faster model inference on CPU
# Requires: yolov8m.onnx and yolov8m-pose.onnx models
# Generate with: python scripts/export_to_onnx.py
USE_ONNX_RUNTIME=1

# ONNX Model Paths (optional - defaults are fine)
ONNX_YOLO_WEIGHTS=yolov8m.onnx
ONNX_YOLO_POSE_WEIGHTS=yolov8m-pose.onnx

# ===========================================
# TIER 3: Motion-Based Frame Skipping (30-50% frame reduction)
# ===========================================
# Intelligently skips frames with very low motion to reduce processing
ENABLE_MOTION_SKIPPING=1

# Motion thresholds (0.0-1.0 scale)
MOTION_THRESHOLD_LOW=0.005    # Skip frame if motion < 0.5%
MOTION_THRESHOLD_HIGH=0.05    # Always process if motion > 5%

# Safety: Always process every Nth frame regardless of motion
BASELINE_FRAME_INTERVAL=4     # Process every 4th frame minimum

# ===========================================
# TIER 4.1: INT8 Quantization (2-3x additional speedup)
# ===========================================
# Enables INT8 quantized ONNX models for even faster inference
# ⚠️ Prerequisites:
#   1. Add 3-5 sample videos to sample_videos/
#   2. Run: python scripts/create_calibration_dataset.py
#   3. Run: python scripts/quantize_to_int8.py
#   4. Run: python scripts/validate_int8_accuracy.py (verify >95% accuracy)
#   5. Enable below after validation passes
USE_INT8_QUANTIZATION=0  # Set to 1 after creating INT8 models

# INT8 Model Paths (optional - defaults are fine)
INT8_YOLO_WEIGHTS=yolov8m_int8.onnx
INT8_YOLO_POSE_WEIGHTS=yolov8m-pose_int8.onnx

# ===========================================
# TIER 4.2: Async Frame Reader (20-30% I/O overlap)
# ===========================================
# Overlaps video I/O with processing using background thread prefetching
# Benefits: Eliminates I/O wait time, smoother pipeline
USE_ASYNC_FRAME_READER=0  # Set to 1 to enable

# Async buffer size (10-20 recommended)
# Larger = more memory, better I/O smoothing
# Smaller = less memory, still effective
ASYNC_BUFFER_SIZE=15

# ===========================================
# PHASE 1.2: Frame Resolution Reduction (25-40% speedup)
# ===========================================
# Reduces frame resolution before YOLO inference for faster detection
# Coordinates are automatically scaled back to original resolution
# Benefits: Faster inference with minimal accuracy loss (±5px bbox accuracy)
# Default: 640x480 (reduced from typical 1280x720)
DETECTION_WIDTH=640
DETECTION_HEIGHT=480

# ===========================================
# PHASE 1.3: Pose Cache Expansion (10-15% reduction in pose detection calls)
# ===========================================
# Enhances pose caching with intelligent invalidation and statistics tracking
# Benefits:
#   - Reduces redundant pose detection calls when person is stationary
#   - Intelligent cache invalidation based on bbox movement and time
#   - Comprehensive cache hit rate monitoring for optimization
#
# Cache is automatically invalidated when:
#   - Time elapsed > POSE_CACHE_DURATION (default: 1.0 second)
#   - Person bbox moves > POSE_CACHE_BBOX_THRESHOLD (default: 10%)
#   - Frame motion exceeds threshold
ENABLE_POSE_CACHE=1                    # Enable pose caching (1=enabled, 0=disabled)
POSE_CACHE_DURATION=1.0                # Cache duration in seconds
POSE_CACHE_BBOX_THRESHOLD=0.1          # Bbox movement threshold (0.1 = 10% of bbox size)
POSE_CACHE_STATS_INTERVAL=100          # Log cache statistics every N frames

# ===========================================
# Video Processing Settings
# ===========================================
# Sample rate (frames per second to process)
# 0.5 = process 1 frame every 2 seconds
SAMPLE_FPS=0.5

# Multiprocessing settings
ENABLE_MULTIPROCESSING=1
MP_CHUNK_DURATION=6.0        # Chunk duration in seconds
MP_MAX_WORKERS_CAP=12        # Maximum parallel workers

# ===========================================
# YOLO Model Settings
# ===========================================
# PyTorch model paths (used if ONNX disabled or not found)
YOLO_WEIGHTS_PRELOAD=yolov8m.pt
YOLO_POSE_WEIGHTS=yolov8m-pose.pt
YOLO_POSE_CONFIDENCE=0.45

# ===========================================
# Image Preprocessing (for MediaPipe)
# ===========================================
ENABLE_IMAGE_PREPROCESSING=1
USE_CLAHE=1
USE_GAMMA_CORRECTION=1
USE_UNSHARP_MASKING=0        # Optional, can add artifacts
USE_NOISE_REDUCTION=1
ADAPTIVE_PREPROCESSING=1
CLAHE_CLIP_LIMIT=1.5
CLAHE_TILE_GRID_SIZE=[16,16]
GAMMA_VALUE=1.2

# ===========================================
# Output Settings
# ===========================================
# Save annotated frames
SAVE_ANNOTATED_FRAMES=1
FRAME_SAVE_INTERVAL=1

# ===========================================
# External API Settings (CVVR)
# ===========================================
CVVR_API_ENABLED=1
CVVR_API_URL=https://api.mindcoinapps.com/ai_demo_api/cvvr/cvvrTripViolations/addUpdateBulk
CVVR_API_URL_NO_EVENTS=https://api.mindcoinapps.com/ai_demo_api/cvvr/cvvrTripViolations/addUpdateBulkNoEvents
CVVR_API_TOKEN=your_api_token_here
CVVR_API_TIMEOUT=30
HOST_URL=https://celebxmedia.info

# ===========================================
# Performance Tuning (Advanced)
# ===========================================
# Threading settings
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

# ===========================================
# Quick Start Guide
# ===========================================
# 1. Baseline (Tiers 1-3):
#    USE_ONNX_RUNTIME=1
#    USE_INT8_QUANTIZATION=0
#    USE_ASYNC_FRAME_READER=0
#    Expected: 3.5-5x speedup
#
# 2. Add INT8 (Tier 4.1):
#    - Follow INT8 setup instructions above
#    USE_INT8_QUANTIZATION=1
#    Expected: 5.5-7.5x speedup
#
# 3. Add Async I/O (Tier 4.2):
#    USE_ASYNC_FRAME_READER=1
#    Expected: 6-8x speedup
#
# 4. Full Optimization (All Tiers):
#    USE_ONNX_RUNTIME=1
#    USE_INT8_QUANTIZATION=1
#    USE_ASYNC_FRAME_READER=1
#    ENABLE_MOTION_SKIPPING=1
#    Expected: 7-10x speedup
#
# Benchmark: python scripts/benchmark_tier4.py --video path/to/test.mp4
