# ==========================================================================
# Locopilot Monitoring System - Environment Configuration Template
# ==========================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env files with real credentials to version control.
# ==========================================================================

# Model Configuration
YOLO_WEIGHTS_PRELOAD=yolo26n.pt
YOLO_POSE_WEIGHTS=yolo26n-pose.pt
YOLO_ROI_WEIGHTS=yolo26s.pt          # Stronger model for pose-guided ROI crop detection
YOLO_ROI_CONFIDENCE=0.15             # Lower threshold for small object recall in crops

# Hand gesture coordination temporal window (seconds)
HAND_GESTURE_COORDINATION_WINDOW=5.0

# ============================================================================
# PERFORMANCE OPTIMIZATION SETTINGS
# ============================================================================

# Thread Configuration
TORCH_THREADS=1
OPENCV_THREADS=2
MP_MAX_WORKERS_CAP=2
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=7200

# Inference Parameters
YOLO_IMGSZ=640
YOLO_DEVICE=0

# GPU Batch Processing
GPU_BATCH_SIZE=8
GPU_BATCH_ENABLED=1

# Multiprocessing Configuration
MP_CHUNK_DURATION=15.0
ENABLE_MULTIPROCESSING=1

# ============================================================================
# MINIO CONFIGURATION (Video Downloads)
# ============================================================================
MINIO_ENDPOINT=your-minio-host:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_SECURE=1
MINIO_BUCKET=cvss

# ============================================================================
# ACTIVITY AGGREGATION
# ============================================================================
ACTIVITY_MERGE_ENABLED=0

# ============================================================================
# HOST URL (for media links in API responses)
# ============================================================================
HOST_URL=https://your-host-url.com

# ============================================================================
# VOTING THRESHOLDS
# ============================================================================
VOTING_THRESHOLD_CELL_PHONE=0.8
VOTING_THRESHOLD_WRITING=0.8
VOTING_THRESHOLD_PACKING_BAGS=0.8
VOTING_THRESHOLD_LP_GESTURE=0.8
VOTING_THRESHOLD_ALP_GESTURE=0.8
VOTING_THRESHOLD_MIND_DIVERSION=0.8
VOTING_THRESHOLD_GROUP=0.8

# ============================================================================
# TRAIN MOTION-BASED RULES
# ============================================================================
TRAIN_MOTION_RULES_ENABLED=1
TRIP_API_URL=https://api.railradar.in/api/v1/trains

# ============================================================================
# TRAIN MOTION DETECTION (vibration-based)
# ============================================================================
# Detects train running/stopped by analyzing frame-to-frame pixel jitter on
# person-masked cab interior surfaces + side window optical flow.
# When STOPPED: only group_detected (>5 persons) and no_person_detected are flagged.
TRAIN_MOTION_DETECTION_ENABLED=0          # Feature flag (0=off, 1=on)
TRAIN_MOTION_VIB_THRESHOLD=1.0            # Mean abs diff above this = vibrating
TRAIN_MOTION_VIB_HIGH=3.0                 # Definite motion threshold
TRAIN_MOTION_WINDOW_ROI_LP=0.0,0.05,0.12,0.85    # Side window ROI for LP side camera (left edge strip)
TRAIN_MOTION_WINDOW_ROI_ALP=0.88,0.05,1.0,0.85   # Side window ROI for ALP side camera (right edge strip)
TRAIN_MOTION_RUNNING_THRESHOLD=0.45       # Combined score threshold for RUNNING
TRAIN_MOTION_TEMPORAL_WINDOW=5            # Smoothing window (frames)
TRAIN_MOTION_STOPPED_GROUP_THRESHOLD=5    # Min persons for group_detected when stopped
TRAIN_MOTION_WINDOW_FLOW_THRESHOLD=2.0    # Optical flow magnitude threshold
TRAIN_MOTION_WEIGHT_VIBRATION=0.5         # Weight for vibration signal
TRAIN_MOTION_WEIGHT_WINDOW=0.3            # Weight for window flow signal
TRAIN_MOTION_WEIGHT_STABILITY=0.2         # Weight for block stability signal
TRAIN_MOTION_PERSON_MASK_PADDING=0.10     # Person bbox expansion for masking (10%)
TRIP_API_TIMEOUT=10
PRE_ARRIVAL_WINDOW_START=60
PRE_ARRIVAL_WINDOW_END=30
HALT_GRACE_PERIOD=120

# ============================================================================
# OCR TIMESTAMP EXTRACTION
# ============================================================================
OCR_ENABLED=1
OCR_ENGINE=auto
OCR_ROI_POSITION=top-left
OCR_ROI_X=10
OCR_ROI_Y=10
OCR_ROI_WIDTH=200
OCR_ROI_HEIGHT=50

# ============================================================================
# YOLO CONFIDENCE THRESHOLDS
# ============================================================================
YOLO_PERSON_CONFIDENCE=0.5
YOLO_BAG_CONFIDENCE=0.45
YOLO_BAG_LOG_CONFIDENCE=0.25
YOLO_BOOK_CONFIDENCE=0.4
YOLO_CELL_PHONE_CONFIDENCE=0.3

# ============================================================================
# DETECTION THRESHOLDS (see app/utils/config.py for full list)
# ============================================================================
MAX_WRIST_DISTANCE=300
MAX_ELBOW_DISTANCE=450
WRITING_MIN_DURATION=1.0
WRITING_REQUIRED_CONSECUTIVE=2
SLEEP_STRONG_SCORE=5
SLEEP_STRONG_DURATION=30
SLEEP_MICROSLEEP_DURATION=4
