# ==========================================================================
# Locopilot Monitoring System - Environment Configuration Template
# ==========================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env files with real credentials to version control.
# ==========================================================================

# Model Configuration
YOLO_WEIGHTS_PRELOAD=yolo26n.pt
YOLO_POSE_WEIGHTS=yolo26n-pose.pt

# Hand gesture coordination temporal window (seconds)
HAND_GESTURE_COORDINATION_WINDOW=5.0

# Forward-looking hand gesture coordination (deferred violation check)
# When one person raises hand, wait this long for the other to respond before flagging.
# Filters transient raises (controls, drinking) that only trigger 1 frame.
HAND_GESTURE_FORWARD_WINDOW=4.0
# Minimum frames with hand raised within the window to confirm waving gesture.
# At 0.5fps over 4s (2-3 frames), real waving shows raise_count >= 2.
HAND_GESTURE_MIN_RAISE_COUNT=2

# ============================================================================
# PERFORMANCE OPTIMIZATION SETTINGS
# ============================================================================

# Thread Configuration
TORCH_THREADS=1
OPENCV_THREADS=2
MP_MAX_WORKERS_CAP=2
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=7200

# Inference Parameters
YOLO_IMGSZ=640
YOLO_DEVICE=0

# GPU Batch Processing
GPU_BATCH_SIZE=8
GPU_BATCH_ENABLED=1

# Multiprocessing Configuration
MP_CHUNK_DURATION=15.0
ENABLE_MULTIPROCESSING=1

# ============================================================================
# MINIO CONFIGURATION (Video Downloads)
# ============================================================================
MINIO_ENDPOINT=your-minio-host:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_SECURE=1
MINIO_BUCKET=cvss

# ============================================================================
# ACTIVITY AGGREGATION
# ============================================================================
ACTIVITY_MERGE_ENABLED=0

# ============================================================================
# HOST URL (for media links in API responses)
# ============================================================================
HOST_URL=https://your-host-url.com

# ============================================================================
# VOTING THRESHOLDS
# ============================================================================
VOTING_THRESHOLD_CELL_PHONE=0.8
VOTING_THRESHOLD_WRITING=0.8
VOTING_THRESHOLD_PACKING_BAGS=0.8
VOTING_THRESHOLD_LP_GESTURE=0.8
VOTING_THRESHOLD_ALP_GESTURE=0.8
VOTING_THRESHOLD_MIND_DIVERSION=0.8
VOTING_THRESHOLD_GROUP=0.8

# ============================================================================
# TRAIN MOTION-BASED RULES
# ============================================================================
TRAIN_MOTION_RULES_ENABLED=1
TRIP_API_URL=https://api.railradar.in/api/v1/trains
TRIP_API_TIMEOUT=10
PRE_ARRIVAL_WINDOW_START=60
PRE_ARRIVAL_WINDOW_END=30
HALT_GRACE_PERIOD=120

# ============================================================================
# OCR TIMESTAMP EXTRACTION
# ============================================================================
OCR_ENABLED=1
OCR_ENGINE=auto
OCR_ROI_POSITION=top-left
OCR_ROI_X=10
OCR_ROI_Y=10
OCR_ROI_WIDTH=200
OCR_ROI_HEIGHT=50

# ============================================================================
# YOLO CONFIDENCE THRESHOLDS
# ============================================================================
YOLO_PERSON_CONFIDENCE=0.5
YOLO_BAG_CONFIDENCE=0.45
YOLO_BAG_LOG_CONFIDENCE=0.25
YOLO_BOOK_CONFIDENCE=0.4
YOLO_CELL_PHONE_CONFIDENCE=0.3

# ============================================================================
# YOLO PREPROCESSING
# ============================================================================
# Always apply bilateral+CLAHE preprocessing (not just dark frames).
# Reduces H.264 compression artifacts that hurt detection on ALL frames.
# Set to 0 to restore old behavior (only preprocess when brightness < 0.4).
YOLO_ALWAYS_PREPROCESS=1

# ============================================================================
# STATIC ZONE SUPPRESSION (fixed-camera false positive filtering)
# ============================================================================
# Suppress persistent FP detections from fixed objects in the cab.
# Set ZONE_SUPPRESSION_ENABLED=0 to disable all zone suppression.
ZONE_SUPPRESSION_ENABLED=1
# Comma-separated YOLO class names to always ignore (e.g., "chair,couch")
ZONE_SUPPRESS_CLASSES=chair
# JSON list of [x1,y1,x2,y2] normalized [0,1] regions where suitcase = seat cushion FP.
# Example: "[[0.1, 0.5, 0.4, 0.9]]" — empty string means no region suppression.
ZONE_SUPPRESS_SUITCASE_REGIONS=

# ============================================================================
# SAHI (Sliced Aided Hyper Inference) for Small Object Detection
# ============================================================================
# Runs tiled inference on person ROI crops to detect small objects (cell phone, book)
# that standard YOLO misses. Increases processing time (~50-100ms per person per frame).
# Requires: pip install sahi
SAHI_ENABLED=0
SAHI_SLICE_HEIGHT=640
SAHI_SLICE_WIDTH=640
SAHI_OVERLAP_RATIO=0.2
SAHI_POSTPROCESS_TYPE=NMM
SAHI_POSTPROCESS_MATCH_THRESHOLD=0.5

# ============================================================================
# HAAR CASCADE EYE DETECTION
# ============================================================================
# Disabled by default: Haar cascade is non-functional from overhead camera
# (LP eye region ~13px, ALP ~3px). Reclined posture detection replaces it.
# Set to 1 to re-enable for non-overhead camera angles.
HAAR_EYE_DETECTION_ENABLED=0

# ============================================================================
# SLEEP DETECTION - RECLINED POSTURE
# ============================================================================
# Score boost when reclined posture detected (torso elongated + shoulders compressed).
# Acts as independent sleep detection path alongside head_drop and haar_eye_closed.
SLEEP_RECLINED_POSTURE_SCORE=5

# ============================================================================
# DETECTION THRESHOLDS (see app/utils/config.py for full list)
# ============================================================================
MAX_WRIST_DISTANCE=300
MAX_ELBOW_DISTANCE=450
WRITING_MIN_DURATION=1.0
WRITING_REQUIRED_CONSECUTIVE=2
SLEEP_STRONG_SCORE=5
SLEEP_STRONG_DURATION=30
SLEEP_MICROSLEEP_DURATION=4
