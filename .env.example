FACE_MESH_DETECTION_CONFIDENCE=0.5

# face mesh tracking confidence
FACE_MESH_TRACKING_CONFIDENCE=0.5

# activity cell phone margin
ACTIVITY_CELL_PHONE_MARGIN=180

# activity writing margin
ACTIVITY_WRITING_MARGIN=180

# activity packing margin
ACTIVITY_PACKING_MARGIN=100

# activity packing region margin
ACTIVITY_PACKING_REGION_MARGIN=150

# activity packing wrist inside margin
ACTIVITY_PACKING_WRIST_INSIDE_MARGIN=80

# train motion rules enabled
TRAIN_MOTION_RULES_ENABLED=0

# When 1 (default), writing/eating/packing/sleep/mind_diversion/lp_alp_hand_gesture
# detected while the train is STOPPED are zeroed at the gate and never reach the
# VLM verifier or the external API — matching original "violations only count
# while moving" behavior. Set to 0 to forward all detections regardless of motion
# state; they will carry motionState=STOPPED in activities.json and the posted
# payload so the customer can distinguish station-context events. cell_phone and
# microsleep are always forwarded regardless of this flag (safety-critical).
TRAIN_MOTION_SUPPRESS_WHEN_STOPPED=1

# suppress no person without schedule
SUPPRESS_NO_PERSON_WITHOUT_SCHEDULE=1

# trip api url
TRIP_API_URL=https://api.railradar.in/api/v1/trains

# trip api timeout
TRIP_API_TIMEOUT=10

# ocr enabled
OCR_ENABLED=0

# ocr engine
OCR_ENGINE=auto

# ocr roi position
OCR_ROI_POSITION=top-left

# ocr roi x
OCR_ROI_X=10

# ocr roi y
OCR_ROI_Y=10

# ocr roi width
OCR_ROI_WIDTH=200

# ocr roi height
OCR_ROI_HEIGHT=50

# pre arrival window start
PRE_ARRIVAL_WINDOW_START=60

# pre arrival window end
PRE_ARRIVAL_WINDOW_END=30

# halt grace period
HALT_GRACE_PERIOD=120

# etrain enabled
ETRAIN_ENABLED=0

# etrain base url
ETRAIN_BASE_URL=https://etrain.info/train

# etrain cache ttl
ETRAIN_CACHE_TTL=1800

# =============================================================================
# VLM Verification Layer (Pipeline-2 FP filter)
# =============================================================================
# Post-Pipeline-1 verifier that sends each confirmed activity's keyframe to a
# vLLM-served Qwen2.5-VL model and asks "is this really the flagged activity?".
# Fail-open: if the endpoint is unreachable, Pipeline-1 verdicts pass through.
# Default OFF; turn on by stages (shadow → enforcement) per the playbook.

# Master switch
VLM_VERIFICATION_ENABLED=0

# vLLM OpenAI-compatible endpoint (run on port 8001 via locopilot-vlm.service)
VLM_BASE_URL=http://localhost:8001/v1
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ

# Activities to verify (comma-separated; match ACTIVITY_REGISTRY keys).
# Activities outside this list are passed through unchanged.
VLM_VERIFY_ACTIVITIES=writing,eating_drinking

# Drop threshold (only used when VLM_SHADOW_MODE=0). Activities with verdict
# FALSE_POSITIVE and confidence >= this value are dropped before external API push.
VLM_DROP_THRESHOLD=0.80

# 1 = record vlm_review on each activity but never drop (safe rollout default).
# 0 = enforce drops per VLM_DROP_THRESHOLD.
VLM_SHADOW_MODE=1

# HTTP timeout per VLM call. On timeout, activity passes through (fail-open).
VLM_TIMEOUT_SECONDS=8.0

# Cap on activities verified per video run (0 = no cap). Useful as a safety net
# during initial rollout if a video produces an unexpected number of fires.
VLM_MAX_ACTIVITIES_PER_RUN=0
