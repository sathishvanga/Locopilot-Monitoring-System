# =============================================================================
# Locopilot Monitoring System - Environment Configuration Template
# =============================================================================
# Auto-generated from app/utils/config.py Settings.model_fields.
# Do not edit manually. Regenerate with:
#
#     python scripts/generate_env_example.py
#
# Copy this file to .env and override only the settings you need to change.
# NEVER commit .env files containing real credentials.
# =============================================================================

# app name
APP_NAME=Locopilot Monitoring System

# app version
APP_VERSION=1.0.0

# debug
DEBUG=0

# host
HOST=0.0.0.0

# port
PORT=8000

# cors allowed origins
CORS_ALLOWED_ORIGINS=["*"]

# Shared secret required in the ``X-API-Key`` header for the media
# (``/api/jobs/{run_id}/media/{filename}``) and status
# (``/api/status/{run_id}``) endpoints. Leave blank during the rollout
# window — the auth dependency logs a one-shot warning and allows the
# request through. Set to a strong random value in ``.env.production``
# once all internal clients have been updated; rotate by updating the
# value and redeploying.
MEDIA_API_KEY=

# max upload size
MAX_UPLOAD_SIZE=5368709120

# allowed video extensions
ALLOWED_VIDEO_EXTENSIONS=[".mp4", ".avi", ".mov", ".mkv"]

# upload dir
UPLOAD_DIR=/tmp/locopilot_uploads

# output dir
OUTPUT_DIR=locopilot_evidence

# save annotated frames
SAVE_ANNOTATED_FRAMES=1

# frame save interval
FRAME_SAVE_INTERVAL=1

# sample fps
SAMPLE_FPS=0.5

# enable multiprocessing
ENABLE_MULTIPROCESSING=1

# mp chunk duration
MP_CHUNK_DURATION=15.0

# Multiprocessing chunk overlap (warm-up) window in seconds. Must be >=
# max(SLEEP_BASELINE_CALIBRATION_WINDOW, HAND_GESTURE_COORDINATION_WINDOW)
# (ARCH-03 / task 0003 — enforced by Settings._validate_overlap_window).
MP_OVERLAP_SECONDS=12.0

# mp max workers
MP_MAX_WORKERS=

# mp max workers cap
MP_MAX_WORKERS_CAP=12

# yolo weights
YOLO_WEIGHTS=yolo26n.pt

# yolo pose weights
YOLO_POSE_WEIGHTS=yolo26n-pose.pt

# yolo pose confidence
YOLO_POSE_CONFIDENCE=0.45

# yolo imgsz
YOLO_IMGSZ=640

# yolo device
YOLO_DEVICE=cpu

# gpu enabled
GPU_ENABLED=1

# gpu device
GPU_DEVICE=cuda:0

# gpu memory fraction
GPU_MEMORY_FRACTION=0.85

# gpu batch size
GPU_BATCH_SIZE=8

# gpu batch enabled
GPU_BATCH_ENABLED=1

# max concurrent videos
MAX_CONCURRENT_VIDEOS=3

# inference batch size
INFERENCE_BATCH_SIZE=8

# job queue max size
JOB_QUEUE_MAX_SIZE=10

# pytorch cuda alloc conf
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# oom retry enabled
OOM_RETRY_ENABLED=1

# log level
LOG_LEVEL=INFO

# log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# log dir
LOG_DIR=logs

# environment
ENVIRONMENT=development

# prod log level
PROD_LOG_LEVEL=INFO

# dev log level
DEV_LOG_LEVEL=DEBUG

# s3 upload api url
S3_UPLOAD_API_URL=https://api.mindcoinapps.com/ai_demo_api/amazonUpload/uploadWithFolder

# cvvr api url
CVVR_API_URL=https://api.mindcoinapps.com/ai_{division}_api/cvvr/cvvrTripViolations/addUpdateBulk

# cvvr api url no events
CVVR_API_URL_NO_EVENTS=https://api.mindcoinapps.com/ai_{division}_api/cvvr/cvvrTripViolations/addUpdateBulkNoEvents

# cvvr api default division
CVVR_API_DEFAULT_DIVISION=ai_demo_api

# cvvr api token
CVVR_API_TOKEN=

# cvvr api timeout
CVVR_API_TIMEOUT=30

# cvvr api enabled
CVVR_API_ENABLED=1

# host url
HOST_URL=https://celebxmedia.info

# minio endpoint
MINIO_ENDPOINT=mind.snikbtel.uk:9000

# minio access key
# SECURITY: replace with the real value before deploying. The application
# fails fast in production when either MinIO credential is empty.
MINIO_ACCESS_KEY=changeme

# minio secret key
# SECURITY: replace with the real value before deploying. The application
# fails fast in production when either MinIO credential is empty.
MINIO_SECRET_KEY=changeme

# minio secure
MINIO_SECURE=1

# minio bucket
MINIO_BUCKET=cvss

# enable image preprocessing
ENABLE_IMAGE_PREPROCESSING=1

# use clahe
USE_CLAHE=1

# use gamma correction
USE_GAMMA_CORRECTION=1

# use unsharp masking
USE_UNSHARP_MASKING=0

# use noise reduction
USE_NOISE_REDUCTION=1

# adaptive preprocessing
ADAPTIVE_PREPROCESSING=1

# clahe clip limit
CLAHE_CLIP_LIMIT=1.5

# clahe tile grid size
