# Production Environment Configuration for Dell PowerEdge R420
# =============================================================
# Hardware: 12-core Xeon, 32GB RAM, 500GB SSD
# OS: Ubuntu 22.04 LTS
# =============================================================

# Environment
ENVIRONMENT=production

# Multiprocessing Configuration
# ✅ GPU OPTIMIZED: 8GB VRAM GPU Server (GTX 1080)
# 2 workers for parallel chunk processing (~914MB each, total ~1.8GB)
MP_MAX_WORKERS_CAP=2
MP_CHUNK_DURATION=5.0

# Worker Thread Configuration
# Reduced for GPU - GPU handles main computation
TORCH_THREADS=1
OPENCV_THREADS=2

# GPU Configuration
YOLO_DEVICE=0

# GPU Batch Processing - Maximize GPU utilization
GPU_BATCH_SIZE=8
GPU_BATCH_ENABLED=1

# ============================================================================
# CELL PHONE DETECTION - Enhanced False Positive Filtering
# ============================================================================
# Model: Upgrade to YOLO11l for better accuracy (~10% fewer false positives)
YOLO_WEIGHTS_PRELOAD=yolo11l.pt
YOLO_POSE_WEIGHTS=yolo11l-pose.pt

# Image size: 640 for better small object detection (was 416)
YOLO_IMGSZ=640

# Confidence threshold: 0.55 for stricter filtering (was 0.45)
CELL_PHONE_CONFIDENCE=0.55

# Temporal filtering: Require 3 consecutive frames (6 sec @ 0.5fps)
# This is configured in code via activity_thresholds

# Control zone filter: Enabled by default
CONTROL_ZONE_FILTER_ENABLED=1

# Memory Management
# With 32GB RAM, we can afford more workers
# Each worker uses ~2-3GB (YOLO + MediaPipe + buffers)
# 11 workers × 2.5GB = ~27GB, leaving 5GB for OS/networking
PRELOAD_MODELS=1

# Gunicorn Configuration (for production deployment)
# Worker count: 3 workers (each handles uvicorn with multiprocessing pool)
# Timeout: 1800s (30 minutes) for long video processing
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=1800
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker

# Logging
LOG_LEVEL=INFO
PROD_LOG_LEVEL=INFO

# API Configuration
CVVR_API_ENABLED=1
CVVR_API_TIMEOUT=30

# Performance Tuning
# Sample FPS: 0.5 for speed, increase to 1.0 for better accuracy
SAMPLE_FPS=0.5

# Video Processing
SAVE_ANNOTATED_FRAMES=0
FRAME_SAVE_INTERVAL=1

# Output directory (production path)
OUTPUT_DIR=/opt/poc2/locopilot_evidence
UPLOAD_DIR=/tmp/locopilot_uploads
LOG_DIR=/opt/poc2/logs

# ============================================================================
# MINIO CONFIGURATION (Video Downloads)
# ============================================================================
MINIO_ENDPOINT=mind.snikbtel.uk:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=login123
MINIO_SECURE=1
MINIO_BUCKET=cvss
HOST_URL=https://celebxmedia.info
# ============================================================================
# OCR FRAME TIMESTAMP EXTRACTION
# ============================================================================
# Extract actual timestamps embedded in video frames (e.g., "11-11-2025 Tue 10:03:47")
# OCR is performed on-demand when activity is confirmed (start/end)
OCR_TIMESTAMP_ENABLED=1
# ROI coordinates (percentage of frame dimensions) - Top-left corner
OCR_TIMESTAMP_ROI_X_START=0.0
OCR_TIMESTAMP_ROI_X_END=0.45
OCR_TIMESTAMP_ROI_Y_START=0.0
OCR_TIMESTAMP_ROI_Y_END=0.12
# OCR preprocessing - CLAHE contrast enhancement
OCR_CLAHE_CLIP_LIMIT=3.0
OCR_CLAHE_TILE_SIZE=8
# Debug mode - enable to see raw OCR output in logs
OCR_TIMESTAMP_DEBUG=1

# Voting Thresholds (increased to 80%)
VOTING_THRESHOLD_CELL_PHONE=0.8
VOTING_THRESHOLD_WRITING=0.8
VOTING_THRESHOLD_PACKING_BAGS=0.8
VOTING_THRESHOLD_LP_GESTURE=0.8
VOTING_THRESHOLD_ALP_GESTURE=0.8
VOTING_THRESHOLD_MIND_DIVERSION=0.8
VOTING_THRESHOLD_GROUP=0.8

# ============================================================================
# TRAIN STATE DETECTION (Stopped Train Violation Exemption)
# ============================================================================
# Detects when train is stopped using ROI-based optical flow analysis
# When stopped, ALL violations are exempted (crew permitted to rest/relax)

# Enable/disable train state detection (1=enabled, 0=disabled)
TRAIN_STATE_DETECTION_ENABLED=1

# Optical flow magnitude threshold (lower = more sensitive to motion)
TRAIN_STATE_MOTION_THRESHOLD=2.0

# Minimum seconds before state changes to STOPPED (temporal filtering)
TRAIN_STATE_MIN_STOPPED_SEC=5.0

# ROI Configuration (for Indian loco cab camera - window on left side)
# Left edge ROI width as fraction of frame (where window is visible)
TRAIN_STATE_ROI_LEFT=0.20
# Top edge ROI height as fraction (optional, for partial window/ceiling)
TRAIN_STATE_ROI_TOP=0.10
# Use adaptive color-based ROI detection (experimental)
TRAIN_STATE_ROI_ADAPTIVE=0

# Debug frame saving (for testing/validation)
# Set to 1 to save annotated frames showing ROI, optical flow, and state
TRAIN_STATE_DEBUG_FRAMES=0
TRAIN_STATE_DEBUG_DIR=/opt/poc2/train_state_debug
TRAIN_STATE_DEBUG_INTERVAL=1

# Activities exempted when train is stopped (JSON array)
# All violations exempted by default when train is stationary
STOPPED_STATE_EXEMPT_ACTIVITIES=["cell_phone", "writing", "packing_bags", "mind_diversion", "microsleep", "sleep", "no_person_detected", "group_detected", "lp_hand_gesture", "alp_hand_gesture"]
