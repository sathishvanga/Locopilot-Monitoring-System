# Model Configuration
YOLO_WEIGHTS_PRELOAD=yolo11l.pt
YOLO_POSE_WEIGHTS=yolo11l-pose.pt

# Hand gesture coordination temporal window (seconds)
# Suppress coordination failure alerts if both LP and ALP raised hands within this window
HAND_GESTURE_COORDINATION_WINDOW=5.0

# ============================================================================
# PERFORMANCE OPTIMIZATION SETTINGS (Local: 12 cores)
# ============================================================================

# Phase 1: Thread Configuration (GPU OPTIMIZED)
# With GPU handling inference, fewer CPU threads needed
# GPU does heavy lifting, CPU handles preprocessing/postprocessing
TORCH_THREADS=1
OPENCV_THREADS=2
MP_MAX_WORKERS_CAP=2
GUNICORN_WORKERS=3

# Phase 2: Inference Parameters (1.5-1.8x speedup with 416, or 1.15-1.25x with 640)
# Start with 640 for accuracy validation, then test 416 if needed
# TEMPORARY: Using 640 to validate detection accuracy first
YOLO_IMGSZ=640
YOLO_DEVICE=0

# GPU Batch Processing - Maximize GPU utilization
GPU_BATCH_SIZE=8
GPU_BATCH_ENABLED=1

# Phase 3: Multiprocessing Configuration (1.1-1.15x speedup)
# 15s chunks to ensure hand gesture coordination detection works correctly
# (coordination window is 10s, so 15s chunks capture full coordination sequences)
MP_CHUNK_DURATION=15.0

# Enable multiprocessing (production server has compatible Python/mediapipe)
ENABLE_MULTIPROCESSING=1

# Expected Total Speedup (12-core system):
# - With imgsz=416: 1.4x × 1.5x × 1.1x × 1.2x (quick wins) = 2.77x → ~7.2 min
# - With imgsz=640: 1.4x × 1.15x × 1.1x × 1.2x (quick wins) = 2.09x → ~9.6 min

# ============================================================================
# MINIO CONFIGURATION (Video Downloads)
# ============================================================================
MINIO_ENDPOINT=mind.snikbtel.uk:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=login123
MINIO_SECURE=1
MINIO_BUCKET=cvss

# ============================================================================
# ACTIVITY AGGREGATION (disable to see all individual detections)
# ============================================================================
ACTIVITY_MERGE_ENABLED=0

# ============================================================================
# HOST URL (for media links in API responses)
# ============================================================================
HOST_URL=http://localhost:8000

# Voting Thresholds (increased to 80%)
VOTING_THRESHOLD_CELL_PHONE=0.8
VOTING_THRESHOLD_WRITING=0.8
VOTING_THRESHOLD_PACKING_BAGS=0.8
VOTING_THRESHOLD_LP_GESTURE=0.8
VOTING_THRESHOLD_ALP_GESTURE=0.8
VOTING_THRESHOLD_MIND_DIVERSION=0.8
VOTING_THRESHOLD_GROUP=0.8

# ============================================================================
# TRAIN MOTION-BASED RULES (Station Stop Exemptions)
# ============================================================================
# Enable motion-based rule engine (requires trainNumber and tripDate in API call)
TRAIN_MOTION_RULES_ENABLED=1

# Trip schedule API configuration (RailRadar)
TRIP_API_URL=https://api.railradar.in/api/v1/trains
TRIP_API_TIMEOUT=10

# Pre-arrival window for ALP alertness checks (seconds before station arrival)
PRE_ARRIVAL_WINDOW_START=60
PRE_ARRIVAL_WINDOW_END=30

# Grace period after departure (train still considered "stopped" for this duration)
HALT_GRACE_PERIOD=120

# ============================================================================
# OCR TIMESTAMP EXTRACTION (Extract time from video frame overlay)
# ============================================================================
# Enable OCR to extract embedded timestamps from video frames
OCR_ENABLED=1

# OCR engine: 'easyocr' (recommended for semi-transparent text), 'tesseract', or 'auto'
OCR_ENGINE=auto

# ROI position for timestamp: top-left, top-right, bottom-left, bottom-right
OCR_ROI_POSITION=top-left
OCR_ROI_X=10
OCR_ROI_Y=10
OCR_ROI_WIDTH=200
OCR_ROI_HEIGHT=50
