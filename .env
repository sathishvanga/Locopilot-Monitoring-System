# Production Environment Configuration for GPU Server
# =============================================================
# Hardware: 80-core CPU, 251GB RAM, NVIDIA RTX 4000 Ada (20GB VRAM)
# OS: Ubuntu 24.04 LTS
# =============================================================

# Environment
ENVIRONMENT=production

# Multiprocessing Configuration
# ✅ GPU OPTIMIZED: 20GB VRAM RTX 4000 Ada, 80 CPU cores, 251GB RAM
# 6 workers for parallel chunk processing (~2.5GB each, total ~15GB of 251GB)
MP_MAX_WORKERS_CAP=6
GPU_MAX_WORKERS=6
MP_CHUNK_DURATION=15.0
# Chunk overlap reduced from 12→5s (equal to sleep_baseline + gesture_coord
# validator minimums). 12s previously caused short writing events (~5–8s) to
# land entirely inside a chunk's overlap-warmup window and get orphaned by
# the canonical-start discard filter (video_multiprocessing.py:690). With
# 5s overlap the chunk boundaries align so the activity falls in one
# chunk's canonical region. Verified on TV22.4 GT writing event 14:25–14:46.
MP_OVERLAP_SECONDS=5.0

# Worker Thread Configuration
# More CPU cores available for pre/post processing per worker
TORCH_THREADS=2
OPENCV_THREADS=4

# GPU Configuration
YOLO_DEVICE=0
# GPU is saturated at 1 concurrent video on RTX 4000 Ada — running 2 in
# parallel doesn't improve throughput, only contends on VRAM/kernels and
# risks OOM at 3+. Cap admissions at 1 active + JOB_QUEUE_MAX_SIZE waiters.
MAX_CONCURRENT_VIDEOS=1
JOB_QUEUE_MAX_SIZE=10
GPU_MEMORY_FRACTION=0.90
INFERENCE_BATCH_SIZE=16

# GPU Batch Processing - Maximize GPU utilization with larger batches
GPU_BATCH_SIZE=16
GPU_BATCH_ENABLED=1

# ============================================================================
# YOLO26 DOMAIN MODEL (v8 — rolled back from v9 on 2026-04-21)
# ============================================================================
# Detection + ROI: yolo26s_locopilot_v8 (mAP50 0.776, 9 custom classes).
# v9 (yolo26m_locopilot_v9.pt, mAP50 0.798) was deployed briefly but produced
# two production-visible regressions that outweighed its val-mAP gains:
#   1. Clustered person-detection misses (5+ consecutive frames) → false
#      `no_person_detected` activity on tv20_1.mp4 (v8: 0 FPs on same video).
#   2. Backpack recall collapses when hand deeply occludes the bag — v9
#      produces no bbox at all at conf=0.05 fallback on n_5_violations.mp4
#      frames 481-499, while v8 fires 0.48-0.59 there. Downstream: the
#      `packing_bags` rule (needs ≥6s sustained wrist-inside-bag) can't hit
#      its temporal gate → activity never triggers.
#   3. ~3x inference latency (346s vs 116s on a 27-min video).
# v9 weights are retained at /opt/poc2/yolo26m_locopilot_v9.pt for future
# retraining experiments with occlusion-augmented data.
YOLO_WEIGHTS_PRELOAD=yolo26s_locopilot_v11.pt
YOLO_POSE_WEIGHTS=yolo26l-pose.pt
YOLO_ROI_WEIGHTS=yolo26s_locopilot_v11.pt

# Image size: 640 for better small object detection (was 416).
# (Was briefly 960 during v9 deployment to match training resolution, but the
# +latency vs 0 recall gain trade wasn't worth it, and v9 itself was rolled
# back.)
YOLO_IMGSZ=640

# Confidence threshold: 0.55 for stricter filtering (was 0.45)
CELL_PHONE_CONFIDENCE=0.55

# Temporal filtering: Require 3 consecutive frames (6 sec @ 0.5fps)
# This is configured in code via activity_thresholds

# Control zone filter: Enabled by default
CONTROL_ZONE_FILTER_ENABLED=1

# Memory Management
# With 251GB RAM, memory is not a constraint
# 6 workers × 2.5GB = ~15GB, leaving 236GB for OS/caching
PRELOAD_MODELS=1

# Gunicorn Configuration (for production deployment)
# Worker count pinned to 1 per C-1 remediation (see tasks/code-review-critical-fixes.md).
# GPUResourceManager is a per-process singleton, so N workers multiply the
# MAX_CONCURRENT_VIDEOS cap by N and risk GPU OOM on the 20 GB RTX 4000 Ada.
# Emergency fallback: bump this to 2/3 if the health/admin async I/O starves;
# expect to also lower MAX_CONCURRENT_VIDEOS in lockstep.
# Timeout: 7200s (2 hours) for large video processing (up to 5GB).
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=7200
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker

# Logging
LOG_LEVEL=INFO
PROD_LOG_LEVEL=INFO

# API Configuration
CVVR_API_ENABLED=1
CVVR_API_TIMEOUT=30

# Performance Tuning
# Sample FPS: 0.5 for speed, increase to 1.0 for better accuracy
SAMPLE_FPS=0.5

# Video Processing
SAVE_ANNOTATED_FRAMES=0
FRAME_SAVE_INTERVAL=1

# Output directory (production path)
OUTPUT_DIR=/opt/poc2/locopilot_evidence
UPLOAD_DIR=/tmp/locopilot_uploads
LOG_DIR=/opt/poc2/logs

# ============================================================================
# MINIO CONFIGURATION (Video Downloads)
# ============================================================================
MINIO_ENDPOINT=gpu.mindcoinapps.com:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=login123
MINIO_SECURE=1
MINIO_BUCKET=cvss
HOST_URL=https://celebxmedia.info
# ============================================================================
# OCR FRAME TIMESTAMP EXTRACTION
# ============================================================================
# Extract actual timestamps embedded in video frames (e.g., "11-11-2025 Tue 10:03:47")
# OCR is performed on-demand when activity is confirmed (start/end)
OCR_TIMESTAMP_ENABLED=1
# ROI coordinates (percentage of frame dimensions) - Top-left corner
OCR_TIMESTAMP_ROI_X_START=0.0
OCR_TIMESTAMP_ROI_X_END=0.45
OCR_TIMESTAMP_ROI_Y_START=0.0
OCR_TIMESTAMP_ROI_Y_END=0.12
# OCR preprocessing - CLAHE contrast enhancement
OCR_CLAHE_CLIP_LIMIT=3.0
OCR_CLAHE_TILE_SIZE=8
# Debug mode - enable to see raw OCR output in logs
OCR_TIMESTAMP_DEBUG=1

# Packing bags verification (relaxed — was too strict, 0/10 on every detection)
PACKING_MAX_DIST_RATIO=0.45
PACKING_STRICT_INSIDE=0
PACKING_MIN_BAG_AREA=15000
PACKING_WRIST_VIS=0.3

# Static backpack suppression (filters cabin fixtures detected as backpacks)
PACKING_STATIC_SUPPRESSION_ENABLED=1
# Lowered 2026-04-11 from 0.80: train vibration jitter was resetting the static counter
PACKING_STATIC_IOU_THRESHOLD=0.60
# Lowered 2026-04-20 from 5 → 3: per-worker tracker resets each 15s chunk;
# at 5 frames, 4 pass-through samples (~8s at 0.5fps) were enough window for
# accidental wrist-in-bbox + motion to fire FP packing on static bags (seen
# in Writing_13_25.mp4 crew-handover scene). 3 frames = 2 pass-through (~4s),
# tight enough that real packing (continuous bag manipulation) still fires
# but seated-near-static-bag no longer leaks.
PACKING_STATIC_MIN_FRAMES=3

# Wrist motion gate (require hand movement for packing detection)
PACKING_WRIST_MOTION_GATE_ENABLED=1
PACKING_WRIST_MOTION_MIN_VELOCITY=0.008

# ============================================================================
# TRAIN MOTION-BASED RULES (Station Stop Exemptions)
# ============================================================================
# Enable motion-based rule engine (requires trainNumber and tripDate in API call)
# When enabled, activities like "writing" and "packing_bags" are EXEMPTED when train is stopped
TRAIN_MOTION_RULES_ENABLED=1
TRAIN_MOTION_DETECTION_ENABLED=1
# Calibrated 2026-04-22 from TV22.4 full-video signal analysis (829 samples):
# measured vib_mean distribution p25=2.53, p50=2.93, p75=3.60, p90=4.66.
# Prod's earlier VIB_THRESHOLD=4.0 classified 96% of the video as STOPPED
# because vib p50 (2.93) sits well below 4.0 -> writing was suppressed
# everywhere by apply_train_stopped_suppression.
# Visual ground-truth probe: vib_mean ≈1.6–1.9 over frames 752–778s shows
# crew standing / chairs empty / scene static → that's an actual station
# stop. GT writing window 864–886s has vib 2.3–3.8 (ALP bent over logbook)
# → train running. New thresholds bracket these two regimes:
#   1.8 = above all stopped-segment values, below all GT-window values
#   2.5 = vib score saturates at the start of a confident running state
#   running_threshold 0.35 = combined-score cut after vib_score dominates
# Result: stopped segment 752–778s stays 100% STOPPED, GT window 100% RUNNING,
# full-video 88% RUNNING.
# TRAIN_MOTION_RUNNING_THRESHOLD is added here because the previous .env
# relied on the config.py default (0.45); 0.35 is needed given the narrower
# vib range so the vib_score alone can cross the combined cutoff.
TRAIN_MOTION_VIB_THRESHOLD=1.8
TRAIN_MOTION_VIB_HIGH=2.5
TRAIN_MOTION_RUNNING_THRESHOLD=0.35
# Farneback optical flow on the side-window strip: observed max win_flow=2.89
# with p50=0.34 (most frames have little window motion — camera angle shows
# mostly sky). Prod threshold 2.0 required values above p95 to contribute.
# Lowered so win_score is a useful minor contributor, not a dead signal.
TRAIN_MOTION_WINDOW_FLOW_THRESHOLD=0.8
# Person-mask padding: 0.10 -> 0.20. Wider pad captures motion blur / shadows
# / reflections around the bbox that YOLO's tight bbox misses. Cost: masks
# slightly more interior surface, but train vibration affects all surfaces.
TRAIN_MOTION_PERSON_MASK_PADDING=0.20
# Union last 3 frames of person bboxes (plus current) into the interior mask.
# At 0.5 fps samples, a walking pilot covers large pixel distances between
# samples; 3-frame history keeps their trail masked through sustained walks.
TRAIN_MOTION_PERSON_BBOX_HISTORY=3

# Group detection thresholds — 2026-04-22 raised to 5 per revised rule:
# flag only when more than 5 people (6+) are in the cab. Earlier 3-person
# threshold produced TPs but also caught expected 3-person configurations
# (crew + authorized rider). 6+ is the actual overcrowding signal.
TRAIN_MOTION_RUNNING_GROUP_THRESHOLD=5
TRAIN_MOTION_STOPPED_GROUP_THRESHOLD=5

# Trip schedule API configuration (RailRadar)
TRIP_API_URL=https://api.railradar.in/api/v1/trains
TRIP_API_TIMEOUT=10

# Pre-arrival window for ALP alertness checks (seconds before station arrival)
PRE_ARRIVAL_WINDOW_START=60
PRE_ARRIVAL_WINDOW_END=30

# Grace period after departure (train still considered "stopped" for this duration)
HALT_GRACE_PERIOD=120

# ============================================================================
# OCR TIMESTAMP EXTRACTION (Extract time from video frame overlay)
# ============================================================================
# Enable OCR to extract embedded timestamps from video frames
OCR_ENABLED=1

# OCR engine: 'easyocr' (recommended for semi-transparent text), 'tesseract', or 'auto'
OCR_ENGINE=easyocr

# ROI position for timestamp: top-left, top-right, bottom-left, bottom-right
OCR_ROI_POSITION=top-left
OCR_ROI_X=10
OCR_ROI_Y=10
OCR_ROI_WIDTH=200
OCR_ROI_HEIGHT=50

# ============================================================================
# YOLO CONFIDENCE THRESHOLDS
# ============================================================================
# Raised 2026-04-18 after v8 deployment. v8 per-class mAP50 is much higher than v7's,
# so v7-era permissive thresholds now admit noise. See auto_label/docs/YOLO_TRAINING_REPORT.md.
# person v8 mAP50=0.992 (v7: 0.895); bag 0.955/0.771; book 0.944; cell_phone 0.809.
YOLO_PERSON_CONFIDENCE=0.50
# Minimum person bbox area (pixels). Lowered 2026-04-18 from 65000 — v8 is cleaner,
# less filtering needed for distant LPs.
YOLO_PERSON_MIN_AREA=40000
# Raised 2026-04-18 from 0.25 — v8 backpack mAP50=0.955, handbag 0.771. Static
# suppression + motion gate still active as belt-and-braces.
YOLO_BAG_CONFIDENCE=0.40
YOLO_BAG_LOG_CONFIDENCE=0.40
YOLO_BOOK_CONFIDENCE=0.50
YOLO_CELL_PHONE_CONFIDENCE=0.40

# ============================================================================
# WRIST/ELBOW DETECTION THRESHOLDS (pixels)
# ============================================================================
MAX_WRIST_DISTANCE=300
MAX_ELBOW_DISTANCE=450
MAX_SINGLE_WRIST_DISTANCE=250
WRITING_WRIST_DISTANCE=300
RELAXED_WRIST_DISTANCE=400
ELBOW_VISIBILITY_THRESHOLD=0.25
WRIST_VISIBILITY_THRESHOLD=0.3

# ============================================================================
# WRITING DETECTION THRESHOLDS
# ============================================================================
WRITING_MIN_DURATION=1.0
WRITING_REQUIRED_CONSECUTIVE=4
# Wrist-motion variance gate: combined std(x)+std(y) threshold (pixels) over
# a rolling window of book+hand+head-down samples. Writing produces rhythmic
# wrist motion ≥20px std; stationary paperwork handling is <15px. Tuned from
# field data (ch02_20260404174526_ — paper present but LP not actively
# writing read 6-12 px).
BOOK_POSTURE_MIN_DURATION=2.0
BOOK_POSTURE_REQUIRED_CONSECUTIVE=2

# ============================================================================
# HEAD TILT / SLEEP DETECTION THRESHOLDS
# ============================================================================
HEAD_DOWN_THRESHOLD=0.01
SLEEP_STRONG_SCORE=5
SLEEP_SCORE_THRESH=5
SLEEP_STRONG_DURATION=30
SLEEP_MODERATE_DURATION=30
SLEEP_MICROSLEEP_DURATION=5
# Disable Haar eye cascade: non-functional from overhead camera;
# 3 detectMultiScale passes per person per frame wasted ~30-80s wall-clock.
HAAR_EYE_DETECTION_ENABLED=0
HAAR_EYE_MICROSLEEP_DURATION=5.0
SLEEP_MICROSLEEP_TO_SLEEP_SEC=30
MINIMAL_MOVEMENT_THRESHOLD=0.15
STABLE_POSTURE_VARIANCE=100
EYES_NOT_VISIBLE_THRESHOLD=0.4

# ============================================================================
# BASELINE CALIBRATION & DISCRIMINATING SIGNALS (Pose-Based Sleep)
# ============================================================================
SLEEP_BASELINE_ENABLED=true
SLEEP_BASELINE_WINDOW=5.0
SLEEP_BASELINE_MIN_SAMPLES=3
SLEEP_HEAD_DROP_MIN_CONSECUTIVE=2
SLEEP_BASELINE_NOSE_BELOW_DELTA=70
SLEEP_BASELINE_HEAD_TILT_DELTA=50
SLEEP_BASELINE_TORSO_DELTA=40
SLEEP_BASELINE_SHOULDER_DELTA=20
SLEEP_SUSTAINED_STILLNESS_THRESH=0.03
SLEEP_SUSTAINED_STILLNESS_FRAMES=1
SLEEP_HANDS_CLASPED_THRESH=100
SLEEP_HANDS_CLASPED_FRAMES=1
SLEEP_SUSTAINED_LOW_EYE_FRAMES=2
SLEEP_HANDS_SPREAD_THRESHOLD=180
EYES_NOT_IN_FRAME_THRESHOLD=0.15
SLEEP_OVERHEAD_NOSE_Y_THRESHOLD=0.10

# ============================================================================
# IR FORWARD LEAN DETECTION THRESHOLDS
# ============================================================================
IR_SHOULDER_RELATIVE_THRESHOLD=0.4
IR_BBOX_ASPECT_RATIO_THRESHOLD=1.2
IR_LOW_MOVEMENT_THRESHOLD=0.02
SUB_THRESHOLD_STREAK_LIMIT=3

# ============================================================================
# OBJECT DETECTION GEOMETRY (pixels)
# ============================================================================
BAG_MAX_ASPECT_RATIO=1.2
BAG_MIN_AREA=5000
BAG_MAX_AREA=100000
BOOK_PERSON_MARGIN=150
PERSON_BOOK_OVERLAP_MARGIN=250

# ============================================================================
# POSE VALIDATION
# ============================================================================
MIN_POSE_LANDMARKS=10
MIN_POSE_VISIBILITY=0.3
FACE_MESH_DETECTION_CONFIDENCE=0.5
FACE_MESH_TRACKING_CONFIDENCE=0.5

# ============================================================================
# ACTIVITY REGISTRY DEFAULTS (margins/regions in pixels)
# ============================================================================
ACTIVITY_CELL_PHONE_MARGIN=180
ACTIVITY_WRITING_MARGIN=180
ACTIVITY_PACKING_MARGIN=100
ACTIVITY_PACKING_REGION_MARGIN=150
ACTIVITY_PACKING_WRIST_INSIDE_MARGIN=80


# VLM Verifier (Pipeline-2 FP filter) — added Sun Apr 26 14:21:39 IST 2026
VLM_VERIFICATION_ENABLED=1
VLM_VERIFY_ACTIVITIES=writing,eating_drinking,packing_bags
VLM_TIMEOUT_SECONDS=15
VLM_BASE_URL=http://localhost:8001/v1
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ

# Forward stopped-state activities to VLM + external API; tag motionState=STOPPED
TRAIN_MOTION_SUPPRESS_WHEN_STOPPED=1
VLM_MOTION_OVERRIDE_ENABLED=1
