# Model Configuration
YOLO_WEIGHTS_PRELOAD=yolo11l.pt
YOLO_POSE_WEIGHTS=yolo11l-pose.pt

# Hand gesture coordination temporal window (seconds)
# Suppress coordination failure alerts if both LP and ALP raised hands within this window
HAND_GESTURE_COORDINATION_WINDOW=5.0

# ============================================================================
# PERFORMANCE OPTIMIZATION SETTINGS (Local: 12 cores)
# ============================================================================

# Phase 1: Thread Configuration (CRITICAL - 1.4-1.6x speedup)
# Local machine optimization for 12-core system
# 12 cores / 4 workers = 3 threads per worker (reduces CPU contention)
TORCH_THREADS=3
OPENCV_THREADS=3
MP_MAX_WORKERS_CAP=4

# Phase 2: Inference Parameters (1.5-1.8x speedup with 416, or 1.15-1.25x with 640)
# Start with 640 for accuracy validation, then test 416 if needed
# TEMPORARY: Using 640 to validate detection accuracy first
YOLO_IMGSZ=640
YOLO_DEVICE=cpu

# Phase 3: Multiprocessing Configuration (1.1-1.15x speedup)
# 6s chunks work well for 10-12 workers on 12-core system
MP_CHUNK_DURATION=6.0

# Expected Total Speedup (12-core system):
# - With imgsz=416: 1.4x × 1.5x × 1.1x × 1.2x (quick wins) = 2.77x → ~7.2 min
# - With imgsz=640: 1.4x × 1.15x × 1.1x × 1.2x (quick wins) = 2.09x → ~9.6 min

# ============================================================================
# MINIO CONFIGURATION (Video Downloads)
# ============================================================================
MINIO_ENDPOINT=mind.snikbtel.uk:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=login123
MINIO_SECURE=1
MINIO_BUCKET=cvss

# ============================================================================
# ACTIVITY AGGREGATION (disable to see all individual detections)
# ============================================================================
ACTIVITY_MERGE_ENABLED=0

# ============================================================================
# HOST URL (for media links in API responses)
# ============================================================================
HOST_URL=http://localhost:8000

# ============================================================================
# OCR FRAME TIMESTAMP EXTRACTION
# ============================================================================
# Extract actual timestamps embedded in video frames (e.g., "11-22-2025 Sat 08:07:16")
# instead of using video playback time (starting from 00:00:00)
OCR_TIMESTAMP_ENABLED=1
# ROI coordinates (percentage of frame dimensions) - Top-left corner
OCR_TIMESTAMP_ROI_X_START=0.0
OCR_TIMESTAMP_ROI_X_END=0.45
OCR_TIMESTAMP_ROI_Y_START=0.0
OCR_TIMESTAMP_ROI_Y_END=0.12
# Sample interval - run OCR every N frames for performance
OCR_TIMESTAMP_SAMPLE_INTERVAL=5